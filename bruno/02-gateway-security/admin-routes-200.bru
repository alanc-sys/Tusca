meta {
  name: Admin lista rutas del Gateway (200)
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/admin/routes
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("Retorna 200 y array de rutas", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an("array");
  });
}
