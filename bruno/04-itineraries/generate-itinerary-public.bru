meta {
  name: Generar itinerario optimizado (Público)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/itinerary/generate
  body: json
  auth: none
}

body:json {
  {
    "startPoint": {
      "latitude": -31.4170,
      "longitude": -64.1830
    },
    "availableTimeMinutes": 180,
    "radiusMeters": 2000,
    "transportMode": "WALKING",
    "categories": ["park", "museum", "cafe"]
  }
}

tests {
  test("Status 200 y ruta no vacía dentro del tiempo disponible", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().route).to.be.an("array");
    expect(res.getBody().route.length).to.be.greaterThan(0);
    expect(res.getBody().totalDurationMinutes).to.be.at.most(180);
  });
}
