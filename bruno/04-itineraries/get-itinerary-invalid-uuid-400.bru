meta {
  name: Consultar itinerario con UUID inválido (400)
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/itineraries/no-es-uuid
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenTurista1}}
}

tests {
  test("Retorna 400 VALIDATION_ERROR con formato ApiError", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().code).to.equal("VALIDATION_ERROR");
    expect(res.getBody().message).to.be.a("string");
  });
}
