meta {
  name: W5-02 User2 genera, guarda y comparte ruta compatible (201)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/routes/share
  body: json
  auth: none
}

headers {
  X-Demo-User: user2
}

body:json {
  {
    "itineraryId": "{{itineraryId2}}"
  }
}

script:pre-request {
  const base = bru.getEnvVar("baseUrl");
  const headers = { "Content-Type": "application/json", "X-Demo-User": "user2" };

  // 1) Generar itinerario (endpoint público): valida que el optimizador responda.
  const generated = await bru.sendRequest({
    method: "POST",
    url: base + "/api/itinerary/generate",
    headers: headers,
    data: {
      startPoint: { latitude: -31.4170, longitude: -64.1830 },
      availableTimeMinutes: 180,
      radiusMeters: 2000,
      transportMode: "WALKING",
      categories: ["park", "museum", "cafe"]
    }
  });
  if (generated.status !== 200) {
    throw new Error("W5-02: /api/itinerary/generate devolvió " + generated.status);
  }

  // 2) Guardar con los mismos POIs semilla que user1 → similitud Jaccard = 1.
  const saved = await bru.sendRequest({
    method: "POST",
    url: base + "/api/itineraries",
    headers: headers,
    data: {
      name: "Ruta demo User 2",
      startPoint: { latitude: -31.4170, longitude: -64.1830 },
      transportMode: "WALKING",
      totalDurationMinutes: 95,
      stops: [
        { poiId: "node-seed-1", visitOrder: 1, stayDurationMinutes: 30, travelTimeToNextMinutes: 5, distanceToNextMeters: 250 },
        { poiId: "node-seed-2", visitOrder: 2, stayDurationMinutes: 60, travelTimeToNextMinutes: 0, distanceToNextMeters: 0 }
      ]
    }
  });
  if (saved.status !== 201) {
    throw new Error("W5-02: POST /api/itineraries devolvió " + saved.status);
  }
  bru.setEnvVar("itineraryId2", saved.data.id);

  // 3) El share se ejecuta como petición principal de este .bru.
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("sharedRoute2Id", res.getBody().id);
    // userId viene del claim `sub` del JWT de user2 (UUID de Keycloak).
    bru.setEnvVar("user2Id", res.getBody().userId);
  }
}

tests {
  test("W5-02 - Status 201, ruta activa y captura user2Id", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().active).to.equal(true);
    expect(res.getBody().itineraryId).to.equal(bru.getEnvVar("itineraryId2"));
    expect(res.getBody().userId).to.be.a("string");
    expect(bru.getEnvVar("user2Id")).to.equal(res.getBody().userId);
  });
}
