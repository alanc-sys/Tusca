meta {
  name: W5-09 User2 bloqueado intenta compartir ruta (403)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/routes/share
  body: json
  auth: none
}

headers {
  X-Demo-User: user2
}

