meta {
  name: W6-P2-04 User2 comparte ruta (201)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/routes/share
  body: json
  auth: none
}

headers {
  X-Demo-User: user2
}

body:json {
  {
    "itineraryId": "{{p2Itin2}}"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("p2Share2", res.getBody().id);
  }
}

tests {
  test("W6-P2-04 - Status 201 y ruta activa de user2", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().active).to.equal(true);
    expect(res.getBody().itineraryId).to.equal(bru.getEnvVar("p2Itin2"));
    expect(bru.getEnvVar("p2Share2")).to.equal(res.getBody().id);
  });
}
