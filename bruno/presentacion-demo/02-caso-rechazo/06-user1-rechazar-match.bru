meta {
  name: W6-P2-06 User1 rechaza match (200)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/routes/matches/{{p2MatchId}}/reject
  body: none
  auth: none
}

headers {
  X-Demo-User: user1
}

script:post-response {
  bru.setEnvVar("p2LastStatus", String(res.getStatus()));
}

tests {
  test("W6-P2-06 - Status 200 y match REJECTED", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("REJECTED");
    expect(bru.getEnvVar("p2LastStatus")).to.equal("200");
  });
}
