meta {
  name: W6-P3-05 Admin reactiva a user2 (200)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/admin/users/{{p3User2Id}}/unblock
  body: none
  auth: none
}

headers {
  X-Demo-User: admin1
}

script:post-response {
  bru.setEnvVar("p3LastStatus", String(res.getStatus()));
}

tests {
  test("W6-P3-05 - Status 200 y usuario ACTIVE", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("ACTIVE");
    if (res.getBody().userId) {
      expect(res.getBody().userId).to.equal(bru.getEnvVar("p3User2Id"));
    }
  });
}
