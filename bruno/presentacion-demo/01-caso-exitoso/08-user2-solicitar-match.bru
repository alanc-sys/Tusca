meta {
  name: W6-P1-08 User2 solicita match (201)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/routes/matches/request
  body: json
  auth: none
}

headers {
  X-Demo-User: user2
}

body:json {
  {
    "myRouteId": "{{p1Share2}}",
    "targetRouteId": "{{p1Share1}}"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("p1MatchId", res.getBody().id);
  }
}

tests {
  test("W6-P1-08 - Status 201 y match PENDING", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().status).to.equal("PENDING");
    expect(res.getBody().consentA).to.equal(true);
    expect(res.getBody().consentB).to.equal(false);
    expect(bru.getEnvVar("p1MatchId")).to.equal(res.getBody().id);
  });
}
