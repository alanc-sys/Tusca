meta {
  name: W6-P1-03 User1 comparte ruta (201)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/routes/share
  body: json
  auth: none
}

headers {
  X-Demo-User: user1
}

body:json {
  {
    "itineraryId": "{{p1Itin1}}"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("p1Share1", res.getBody().id);
  }
}

tests {
  test("W6-P1-03 - Status 201 y ruta activa de user1", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().active).to.equal(true);
    expect(res.getBody().itineraryId).to.equal(bru.getEnvVar("p1Itin1"));
    expect(bru.getEnvVar("p1Share1")).to.equal(res.getBody().id);
  });
}
