}

post {
  url: {{baseUrl}}/api/routes/matches/{{p1MatchId}}/accept
  body: none
  auth: none
}

headers {
  X-Demo-User: user1
}

script:post-response {
  bru.setEnvVar("p1LastStatus", String(res.getStatus()));
}

tests {
