meta {
  name: Solicitar match Turista 1 -> Turista 2 (201)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/routes/matches/request
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenTurista1}}
}

body:json {
  {
    "myRouteId": "{{sharedRoute1Id}}",
    "targetRouteId": "{{sharedRoute2Id}}"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("matchId", res.getBody().id);
  }
}

tests {
  test("Status 201, estado PENDING y solo consentA", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().status).to.equal("PENDING");
    expect(res.getBody().consentA).to.equal(true);
    expect(res.getBody().consentB).to.equal(false);
  });
}
