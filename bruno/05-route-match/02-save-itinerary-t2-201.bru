meta {
  name: Guardar itinerario Turista 2 para match (201)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/itineraries
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenTurista2}}
}

body:json {
  {
    "name": "Ruta Centro Turista 2",
    "startPoint": {
      "latitude": -31.4172,
      "longitude": -64.1832
    },
    "transportMode": "WALKING",
    "totalDurationMinutes": 95,
    "stops": [
      {
        "poiId": "node-seed-1",
        "visitOrder": 1,
        "stayDurationMinutes": 30,
        "travelTimeToNextMinutes": 5,
        "distanceToNextMeters": 250
      },
      {
        "poiId": "node-seed-2",
        "visitOrder": 2,
        "stayDurationMinutes": 60,
        "travelTimeToNextMinutes": 0,
        "distanceToNextMeters": 0
      }
    ]
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("itineraryId2", res.getBody().id);
  }
}

tests {
  test("Status 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
