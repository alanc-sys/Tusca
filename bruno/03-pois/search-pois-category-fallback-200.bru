meta {
  name: Categoría inexistente hace fallback a POIs generales (RN-04)
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/pois/search?lat=-31.4167&lon=-64.1836&radiusMeters=1500&categories=aquarium
  body: none
  auth: none
}

tests {
  test("Retorna 200 con POIs populares generales", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an("array");
    expect(res.getBody().length).to.be.greaterThan(0);
  });
}
