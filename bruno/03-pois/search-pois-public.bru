meta {
  name: Buscar POIs en Córdoba (Público)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/pois/search?lat=-31.4167&lon=-64.1836&radiusMeters=1500&categories=museum,park,cafe
  body: none
  auth: none
}

script:post-response {
  if (res.getStatus() === 200 && Array.isArray(res.getBody()) && res.getBody().length > 0) {
    bru.setEnvVar("firstPoiId", res.getBody()[0].id);
  }
}

tests {
  test("Status 200 y lista de POIs", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an("array");
    expect(res.getBody().length).to.be.greaterThan(0);
  });
}
