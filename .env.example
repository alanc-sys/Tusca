# RutaTur — plantilla de variables de entorno.
#
#   cp .env.example .env
#
# `.env` no se versiona (ver .gitignore). Los valores de ejemplo son solo para desarrollo local:
# cambialos antes de desplegar en cualquier entorno compartido.

# Una base de datos PostgreSQL dedicada por servicio (contenedores postgres-poi,
# postgres-itinerary, postgres-match y postgres-keycloak). La misma variable se usa para crear
# el usuario dentro del contenedor y para que el microservicio se conecte, así que las
# credenciales de ambos lados no pueden desincronizarse.
POI_DB_PASSWORD=poi_pass
ITINERARY_DB_PASSWORD=itinerary_pass
MATCH_DB_PASSWORD=match_pass
KEYCLOAK_DB_PASSWORD=keycloak_pass

# Consola de administración de Keycloak (http://localhost:8180/admin).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Secreto del cliente confidencial `rutatur-match` (service account con view-users).
KEYCLOAK_MATCH_CLIENT_SECRET=rutatur-match-secret

# Token compartido para llamadas servicio-a-servicio sobre /internal/**.
RUTATUR_INTERNAL_TOKEN=rutatur-dev-internal-token

# Proveedores externos.
RUTATUR_OVERPASS_URL=https://overpass-api.de/api/interpreter
RUTATUR_OSRM_BASE_URL=http://router.project-osrm.org

# Orígenes permitidos por CORS en el gateway (separados por coma).
RUTATUR_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
