# ==============================================================================
# RutaTur - Variables de entorno (copiar a .env y completar secretos)
# ==============================================================================

# --- Obligatorias (hacen fallar el arranque si faltan) ---
POSTGRES_USER=rutatur_admin
POSTGRES_PASSWORD=changeme_postgres_secret
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme_keycloak_secret

# --- PostgreSQL 15 (instancia única con bases y usuarios aislados por servicio) ---
POSTGRES_DB=rutatur
POSTGRES_PORT=5432

KEYCLOAK_DB_USER=keycloak_user
KEYCLOAK_DB_PASSWORD=changeme_keycloak_db
POI_DB_USER=poi_user
POI_DB_PASSWORD=changeme_poi_db
ITINERARY_DB_USER=itinerary_user
ITINERARY_DB_PASSWORD=changeme_itinerary_db
MATCH_DB_USER=match_user
MATCH_DB_PASSWORD=changeme_match_db

# --- Keycloak 25 ---
KEYCLOAK_PORT=8180
KC_HOSTNAME=http://keycloak:8080
KEYCLOAK_ISSUER_URI=http://keycloak:8080/realms/rutatur

# --- API Gateway ---
GATEWAY_PORT=8080

# --- Herramientas opcionales (docker compose --profile tools up -d) ---
PGADMIN_EMAIL=admin@rutatur.local
PGADMIN_PASSWORD=changeme_pgadmin_secret
PGADMIN_PORT=5050

# --- Seguridad interna entre microservicios ---
INTERNAL_SERVICE_TOKEN=changeme_internal_token
