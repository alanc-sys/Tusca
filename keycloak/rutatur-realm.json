{
  "realm": "rutatur-realm",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 900,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "ROLE_USER",
        "description": "Usuario autenticado de RutaTur"
      },
      {
        "name": "ROLE_ADMIN",
        "description": "Administrador de RutaTur"
      }
    ]
  },
  "users": [
    {
      "username": "user1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Usuario",
      "lastName": "Uno",
      "email": "user1@rutatur.local",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "requiredActions": [],
      "realmRoles": [
        "ROLE_USER"
      ]
    },
    {
      "username": "admin1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Uno",
      "email": "admin1@rutatur.local",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "requiredActions": [],
      "realmRoles": [
        "ROLE_USER",
        "ROLE_ADMIN"
      ]
    },
    {
      "username": "service-account-rutatur-match",
      "enabled": true,
      "emailVerified": false,
      "serviceAccountClientId": "rutatur-match",
      "credentials": [],
      "requiredActions": [],
      "clientRoles": {
        "realm-management": [
          "view-users"
        ]
      }
    }
  ],
  "clients": [
    {
      "clientId": "rutatur-api",
      "name": "RutaTur public API client",
      "description": "Cliente público para curl, Swagger y pruebas con user1/admin1",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "*"
      ],
      "webOrigins": [
        "*"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "rutatur-gateway",
      "name": "RutaTur API Gateway",
      "description": "Cliente confidencial que el gateway usa solo para validar tokens",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "secret": "rutatur-gateway-secret",
      "redirectUris": [],
      "webOrigins": []
    },
    {
      "clientId": "rutatur-match",
      "name": "RutaTur route-match service account",
      "description": "Cliente confidencial con service account y rol realm-management:view-users",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "secret": "rutatur-match-secret",
      "redirectUris": [],
      "webOrigins": []
    }
  ]
}
